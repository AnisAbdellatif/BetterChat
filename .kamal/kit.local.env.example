# Copy to .kamal/kit.local.env (git-ignored) on each machine that deploys. The kit exports these, so Kamal's configs
# (config/deploy*.yml) and .kamal/secrets-common read them too.

# Kamal and the kit run in the kit's image (docs/runner.md in .kamal/kit): only bash, git and Docker needed here.
# Leave it out if Kamal is installed on this machine (gem install kamal).
KIT_RUNNER=docker

# The VPS and its deploy user (in the docker group, with your SSH key).
BC_HOST=
# BC_SSH_USER=deploy
# BC_SSH_PORT=22

# The server logs in to ghcr.io with this before pulling. A GitHub token with read:packages only (Settings →
# Developer settings → Personal access tokens → Tokens (classic)); it's stored on the server by `docker login`.
KAMAL_REGISTRY_PASSWORD=

# Where the kit's deploy notifications go: Telegram, a webhook (Slack, Discord), or ntfy.
# KIT_TELEGRAM_BOT_TOKEN=
# KIT_TELEGRAM_CHAT_ID=
# KIT_NTFY_URL=
