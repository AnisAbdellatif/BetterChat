# A standby group: two roles, one active (holding a lease, a lock, the only
# consumer of a queue...). A deploy updates the standby only; once it is
# healthy, the active one hands over. The old active stays on the previous
# build as the new standby, so `kit group switch <group>` is an instant
# rollback. docs/groups.md.
#
# In config/deploy.yml, the two roles are the same service twice, each with
# its own volumes (never shared: the kit stops the standby before replacing
# it, but two roles must never write the same files):
#
#   servers:
#     worker_a:
#       hosts: [<host>]
#       cmd: bin/worker
#       env: { clear: { WORKER_ID: worker-a } }
#       options: { volume: "app_worker_a:/data" }
#     worker_b: ... worker-b, app_worker_b ...

KIT_GROUP_STRATEGY=standby
KIT_GROUP_ROLES="worker_a worker_b"

# Stop the standby before replacing it: Kamal otherwise runs old and new
# side by side for a moment, on the same volumes.
KIT_GROUP_STOP_FIRST=true

# How long a new standby may take to be healthy, and the handover to happen.
KIT_GROUP_HEALTH_TIMEOUT=180
KIT_GROUP_SWITCH_TIMEOUT=90

# When the handover fails: report (leave it for you) or switch-back.
KIT_GROUP_ON_SWITCH_FAILURE=report

# Scripts in this folder: active (required), healthy, handover, before,
# after, before-role, after-role. Or one-liners:
# KIT_GROUP_HEALTHY_CMD='"$KIT" role-exec "$KIT_ROLE" "curl -fsS http://127.0.0.1:4000/health"'
