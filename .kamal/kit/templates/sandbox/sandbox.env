# kit sandbox settings for this project (committed). Defaults and every
# setting: the kit's lib/defaults.sh ("kit sandbox") and docs/sandbox.md.

# The Kamal configs to deploy, in order (default: the project's config).
# KIT_SANDBOX_CONFIGS="config/deploy.yml"

# Variables your Kamal configs read from the environment (ERB), as the
# sandbox needs them: NAME=value, space separated. The deployer gets these,
# and never your .kamal/kit.local.env.
# KIT_SANDBOX_ENV="MY_HOST=127.0.0.1 MY_SSH_USER=root"

# Where hooks' KIT_SANDBOX_SERVER_DIR appears on the "server" (the path
# your roles' env-file options and the like expect).
# KIT_SANDBOX_SERVER_PATH=/srv/sandbox

# Ports on 127.0.0.1 (change them if one is taken).
# KIT_SANDBOX_SSH_PORT=2222
# KIT_SANDBOX_REGISTRY_PORT=5555
# KIT_SANDBOX_PROXY_PORT=8080
