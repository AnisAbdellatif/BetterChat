#!/usr/bin/env bash
# Writes the secrets the sandbox's containers read, once (kept in
# KIT_SANDBOX_SERVER_DIR across runs). Generated values: the sandbox never
# needs a real secret. Here, an env file a role names with
#   options: { env-file: /srv/sandbox/secrets/app.env }
set -euo pipefail
dir="$KIT_SANDBOX_SERVER_DIR/secrets"
[ -f "$dir/app.env" ] && exit 0
mkdir -p "$dir"
rand() { head -c 256 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c "${1:-32}"; }
umask 077
cat >"$dir/app.env" <<ENV
SECRET_KEY_BASE=$(rand 64)
DATABASE_URL=postgres://app:sandbox@db/app
ENV
