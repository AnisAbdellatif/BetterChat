# deploy-kit settings for this project (committed). Every setting and its
# default: .kamal/kit/lib/defaults.sh; explained in the kit's
# docs/configuration.md.
#
# Per destination: a file .kamal/kit.<destination>.env, or a suffix here
# (KIT_DEPLOY_BRANCH_STAGING=dev). Personal overrides: .kamal/kit.local.env
# (git-ignored). One-off: KIT_SKIP=ci-green kit deploy.

# --- Gates -----------------------------------------------------------------
KIT_DEPLOY_BRANCH=main
# KIT_DEPLOY_BRANCH_STAGING=dev

# Which CI checks must pass (names as GitHub shows them); empty: all of them.
# KIT_CI_REQUIRED="test lint"
# KIT_CI_WAIT=600                # wait up to 10 minutes for CI still running

# Ask to type the destination before deploying to it.
# KIT_CONFIRM_PRODUCTION=true

# Images built by CI and deployed with --skip-push: verify their attestation.
# KIT_HOOK_PRE_DEPLOY="freeze role-guard require-branch require-pushed ci-green attestation notify"
# KIT_IMAGE=ghcr.io/<owner>/<app>
# KIT_ATTESTATION_SIGNER_WORKFLOW=<owner>/<app>/.github/workflows/build.yml

# --- After the deploy ------------------------------------------------------
# Checked through the real proxy; kit deploy rolls back if they fail.
# KIT_SMOKE_URLS="https://example.com/up https://example.com/|200|<title>"
# KIT_SMOKE_URLS_STAGING="https://staging.example.com/up"

# --- Notifications ---------------------------------------------------------
# Secrets don't belong here: put them in .kamal/kit.local.env, or read them
# from your secrets store in the environment.
# KIT_TELEGRAM_BOT_TOKEN=
# KIT_TELEGRAM_CHAT_ID=
# KIT_WEBHOOK_URL=
# KIT_NTFY_URL=
# KIT_NOTIFY_LEVELS="info success warning error"

# --- Groups ----------------------------------------------------------------
# Roles deployed by a strategy: .kamal/groups/<name>/ (docs/groups.md).
# KIT_GROUP_ORDER="workers receivers"
