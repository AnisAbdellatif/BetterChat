#!/usr/bin/env bash
# Asks you to type the destination (or the service) before deploying, when
# KIT_CONFIRM is on (e.g. KIT_CONFIRM_PRODUCTION=true). Reads the terminal
# itself; with no terminal, KIT_CONFIRM_NONINTERACTIVE decides (fail/allow).
. "$(dirname "$0")/_preamble.sh"

# kit sandbox: local, nothing to check against GitHub, the branch or a freeze.
if [ -n "${KIT_SANDBOX:-}" ]; then
  kit_info "sandbox: confirm skipped"
  exit 0
fi

kit_is_true "$(kit_conf KIT_CONFIRM false)" || exit 0
expected=${KIT_DESTINATION:-${KAMAL_SERVICE:-deploy}}
tty=${KIT_TTY:-/dev/tty}
if ! { : <"$tty"; } 2>/dev/null; then
  case $(kit_conf KIT_CONFIRM_NONINTERACTIVE fail) in
    allow) kit_warn "no terminal to confirm on; allowed by KIT_CONFIRM_NONINTERACTIVE" && exit 0 ;;
    *) kit_die "confirmation required, but there is no terminal (KIT_CONFIRM_NONINTERACTIVE=allow to skip)" ;;
  esac
fi
printf '%s %s (%s) to %s? Type "%s" to continue: ' \
  "${KAMAL_COMMAND:-deploy}" "${KAMAL_SERVICE:-this app}" "${KAMAL_VERSION:-HEAD}" "${KIT_DESTINATION:-its servers}" "$expected" >"$tty"
IFS= read -r answer <"$tty" || answer=
[ "$answer" = "$expected" ] || kit_die "not confirmed"
kit_ok "confirmed"
