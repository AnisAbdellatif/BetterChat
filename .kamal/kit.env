# deploy-kit settings for BetterChat (committed). Every setting and its default: .kamal/kit/lib/defaults.sh;
# explained in the kit's docs/configuration.md. The server itself (address, SSH user), the registry token and
# alert channels go in .kamal/kit.local.env (git-ignored; see kit.local.env.example).
#
# Two destinations, one per branch (config/deploy.<destination>.yml):
#   git switch dev    && .kamal/kit/bin/kit deploy -d dev
#   git switch master && .kamal/kit/bin/kit deploy -d production
# One-off past a gate: each refusal says how (KIT_SKIP=<step>).

# --- Gates -----------------------------------------------------------------
KIT_DEPLOY_BRANCH=master
KIT_DEPLOY_BRANCH_DEV=dev

# Every check of the commit's CI run must pass, the image job included; wait for a run still going, so a deploy can
# start right after a push.
KIT_CI_WAIT=900

# Type "production" before deploying there.
KIT_CONFIRM_PRODUCTION=true

# Images are built, labelled and attested by CI (.github/workflows/ci.yml); a deploy pulls them, never builds, and
# refuses one that workflow didn't build. Nothing is built here, so pre-build has nothing to check.
KIT_DEPLOY_SKIP_PUSH=true
KIT_IMAGE=ghcr.io/anisabdellatif/betterchat
KIT_ATTESTATION_SIGNER_WORKFLOW=AnisAbdellatif/BetterChat/.github/workflows/ci.yml
KIT_HOOK_PRE_BUILD=
KIT_HOOK_PRE_DEPLOY="freeze role-guard require-branch require-clean require-pushed ci-green attestation confirm notify"
# Dev doesn't wait for green: it's where half-finished work is tried in a real browser. It still needs the image
# CI built for the commit, and the smoke test afterwards, so a build that can't boot is rolled back either way.
KIT_HOOK_PRE_DEPLOY_DEV="freeze role-guard require-branch require-clean require-pushed attestation notify"

# --- After the deploy ------------------------------------------------------
# Through the whole chain a visitor goes through (Caddy, kamal-proxy, the app); a failure rolls the deploy back.
KIT_SMOKE_URLS_PRODUCTION="https://betterchat.tech/health|200 https://betterchat.tech/|200"
KIT_SMOKE_URLS_DEV="https://dev.betterchat.tech/health|200"
