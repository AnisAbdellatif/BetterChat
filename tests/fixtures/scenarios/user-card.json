    {
      "call": "watchUser",
      "args": [
        null
      ]
    },
    {
      "frame": "message-spam-1"
    },
    {
      "advance": 180000
    },
    {
      "call": "cachedUserCard",
      "args": [
        "ann"
      ]
    }
  ]
