# Copy to .env. Loaded automatically by `uv run betterchat` (variables already
# set in the environment win) and by docker compose.

# Both required to enable /admin; it answers 404 otherwise. This is HTTP
# Basic Auth: use a long password. In production the host's Caddy provides
# TLS, and the login lives on the server (deploy/app.env.example).
ADMIN_USER=
ADMIN_PASSWORD=

# Local runs (`uv run betterchat`): the port to listen on.
PORT=8010

# Local Docker (docker-compose.yml): the host port to publish (the container
# itself always listens on 8010).
HOST_PORT=8010

# Who may put the chat page in an iframe (CSP frame-ancestors). Unset sends
# no header, which leaves embedding open. For the kick.com embed:
#   FRAME_ANCESTORS='self' https://kick.com
FRAME_ANCESTORS=

# Origins allowed to post heartbeats cross-origin, space or comma separated.
# The dev deployment's page reports to the stable board rather than keeping
# one of its own, so the stable instance names it (config/deploy.production.yml):
#   BEAT_ORIGINS=https://dev.betterchat.tech
# Unset means same-origin only, which is what a lone instance wants.
BEAT_ORIGINS=
