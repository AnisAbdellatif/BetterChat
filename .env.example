# Copy to .env. Loaded automatically by `uv run betterchat` (variables already
# set in the environment win) and by docker compose.

# Both required to enable /admin; it answers 404 otherwise. This is HTTP
# Basic Auth: use a long password. The Cloudflare Tunnel provides TLS.
ADMIN_USER=
ADMIN_PASSWORD=

# Local runs (`uv run betterchat`): the port to listen on.
PORT=8010

# Docker: the host port to publish (the container itself always listens on
# 8010). Point the tunnel at http://localhost:<HOST_PORT>.
HOST_PORT=8010

# Docker: keeps two instances on one host apart. The dev checkout sets these
# to betterchat-dev / dev / 8011, so its containers, its data volume and its
# image are all its own and a dev deploy cannot disturb production.
COMPOSE_PROJECT_NAME=betterchat
IMAGE_TAG=local

# Who may put the chat page in an iframe (CSP frame-ancestors). Unset sends
# no header, which leaves embedding open. For the kick.com embed:
#   FRAME_ANCESTORS='self' https://kick.com
FRAME_ANCESTORS=
