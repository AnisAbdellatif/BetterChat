# The admin login, on the VPS only: /opt/betterchat/app.env (production) and /opt/betterchat-dev/app.env (dev),
# readable by the deploy user only (chmod 600). Never commit the real files. Docker hands this file to the container
# as it is (config/deploy.<destination>.yml, env-file): no quotes around values, they would be kept. Settings that
# aren't secret (FRAME_ANCESTORS, BEAT_ORIGINS) are in config/deploy*.yml. Changes take effect with the next deploy,
# or `kit kamal app boot -d <destination>`. Use a different login for dev.

# Both required to enable /admin; it answers 404 otherwise. This is HTTP Basic Auth: use a long password.
ADMIN_USER=
ADMIN_PASSWORD=
